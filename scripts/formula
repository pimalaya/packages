#!/usr/bin/env bash
# Write into OUT/Formula/ the Homebrew formula of every CLI the catalogue
# ships to homebrew, from its latest release carrying the macOS and Linux
# archives. Given the tap checkout TAP, writes changed=true or changed=false
# to $GITHUB_OUTPUT when set, whether a formula differs from the tap's.
#
# Usage: formula OUT [TAP]

set -euo pipefail
. "$(dirname "$0")/lib.sh"

out=${1:?usage: formula OUT [TAP]}
tap=${2:-}
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$out/Formula"
changed=false

# Each formula system: Homebrew OS, CPU and release system.
systems='macos arm aarch64-darwin
macos intel x86_64-darwin
linux arm aarch64-linux
linux intel x86_64-linux'
names=$(awk '{ print $3 }' <<<"$systems" | jq -R . | jq -sc .)

for cli in $(clis_for homebrew); do
  repo=$(cli_field "$cli" repository)
  tag=$(gh api "repos/$repo/releases?per_page=30" |
    jq -r --arg cli "$cli" --argjson systems "$names" '
      [.[] | select((.draft or .prerelease) | not)
           | select([.assets[].name] as $assets
                    | all($systems[]; . as $s
                          | $assets | index("\($cli).\($s).tgz") != null))
      ][0].tag_name // empty')
  if [[ -z $tag ]]; then die "$cli: no release carries the four archives"; fi

  declare -A sha=()
  while read -r os cpu system; do
    curl -fsSL --retry 3 -o "$work/$cli.$system.tgz" \
      "https://github.com/$repo/releases/download/$tag/$cli.$system.tgz"
    sha[$system]=$(sha256sum "$work/$cli.$system.tgz" | cut -d' ' -f1)
  done <<<"$systems"

  # The install lines, from the layout of the x86_64 Linux archive.
  x=$work/$cli
  mkdir -p "$x"
  tar -xzf "$work/$cli.x86_64-linux.tgz" -C "$x"
  install=("bin.install \"$cli\"")
  for p in share/man share/man/man1; do
    pages=("$x/$p"/*.1.gz)
    if [[ -e ${pages[0]} ]]; then
      install+=("man1.install Dir[\"$p/*.1.gz\"]")
      break
    fi
  done
  for p in "share/completions/$cli.bash" \
    "share/bash-completion/completions/$cli.bash"; do
    if [[ -f $x/$p ]]; then
      install+=("bash_completion.install \"$p\" => \"$cli\"")
      break
    fi
  done
  for p in "share/completions/_$cli" "share/zsh/site-functions/_$cli"; do
    if [[ -f $x/$p ]]; then
      install+=("zsh_completion.install \"$p\"")
      break
    fi
  done
  for p in "share/completions/$cli.fish" \
    "share/fish/vendor_completions.d/$cli.fish"; do
    if [[ -f $x/$p ]]; then
      install+=("fish_completion.install \"$p\"")
      break
    fi
  done
  if [[ -d $x/share/schemas ]]; then
    install+=('(pkgshare/"schemas").install Dir["share/schemas/*"]')
  fi
  if [[ -d $x/share/doc/$cli ]]; then
    install+=("doc.install Dir[\"share/doc/$cli/*\"]")
  fi

  license=$(cli_field "$cli" license)
  if [[ $license == *" OR "* ]]; then
    license="any_of: [\"$(sed 's/ OR /", "/g' <<<"$license")\"]"
  elif [[ $license == *" AND "* ]]; then
    license="all_of: [\"$(sed 's/ AND /", "/g' <<<"$license")\"]"
  else
    license="\"$license\""
  fi

  class=$(sed -E 's/(^|-)([a-z])/\U\2/g' <<<"$cli")
  f=$out/Formula/$cli.rb
  {
    echo "# Generated by pimalaya/packages from the $tag release: do not edit."
    echo "class $class < Formula"
    echo "  desc \"$(cli_field "$cli" description)\""
    echo "  homepage \"https://github.com/$repo\""
    echo "  version \"${tag#v}\""
    echo "  license $license"
    for os in macos linux; do
      echo
      echo "  on_$os do"
      while read -r o cpu system; do
        if [[ $o != "$os" ]]; then continue; fi
        echo "    on_$cpu do"
        echo "      url \"https://github.com/$repo/releases/download/$tag/$cli.$system.tgz\""
        echo "      sha256 \"${sha[$system]}\""
        echo "    end"
      done <<<"$systems"
      echo "  end"
    done
    echo
    echo "  def install"
    printf '    %s\n' "${install[@]}"
    echo "  end"
    echo
    echo "  test do"
    echo "    assert_match version.to_s, shell_output(\"#{bin}/$cli --version\")"
    echo "  end"
    echo "end"
  } >"$f"
  log "wrote Formula/$cli.rb for $tag"

  if [[ -n $tap ]] && ! cmp -s "$f" "$tap/Formula/$cli.rb"; then
    changed=true
  fi
done

log "changed=$changed"
if [[ -n ${GITHUB_OUTPUT:-} ]]; then echo "changed=$changed" >>"$GITHUB_OUTPUT"; fi
